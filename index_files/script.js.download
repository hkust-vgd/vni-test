// Header component loader
async function loadHeaderComponent() {
    const headerPlaceholder = document.getElementById('header-placeholder');
    if (!headerPlaceholder) return Promise.resolve();
    
    try {
        // Determine base path based on current location
        const currentPath = window.location.pathname;
        const isInSubdirectory = currentPath.includes('/research/');
        const basePath = isInSubdirectory ? '../' : '';
        
        // Load header HTML
        const response = await fetch(`${basePath}components/header.html`);
        const headerHTML = await response.text();
        
        // Replace placeholder with actual paths
        const processedHTML = headerHTML.replace(/\{\{BASE_PATH\}\}/g, basePath);
        headerPlaceholder.innerHTML = processedHTML;
        
        // Set active navigation state after header is loaded
        setActiveNavigation();
        
        return Promise.resolve();
        
    } catch (error) {
        console.error('Error loading header:', error);
        // Fallback: keep existing header if loading fails
        return Promise.resolve();
    }
}

// Set active navigation state
function setActiveNavigation() {
    const currentPath = window.location.pathname;
    const currentPage = currentPath.split('/').pop() || 'index.html';
    const navLinks = document.querySelectorAll('.desktop-nav a, .mobile-nav a');
    
    navLinks.forEach(link => {
        link.classList.remove('active');
        const linkHref = link.getAttribute('href');
        const linkPage = linkHref.split('/').pop();
        const dataPage = link.getAttribute('data-page');
        
        // Handle different cases for active state
        if (currentPage === linkPage || 
            (currentPage === '' && linkPage === 'index.html') ||
            (currentPage === 'index.html' && dataPage === 'index') ||
            (currentPage.replace('.html', '') === dataPage)) {
            link.classList.add('active');
        }
        
        // Special handling for research section
        if (currentPath.includes('/research/')) {
            // Mark main Research link as active for all research subpages
            if (dataPage === 'research') {
                link.classList.add('active');
            }
            // Mark specific research subpage as active
            if (linkHref.includes('research/') && currentPage === linkPage) {
                link.classList.add('active');
            }
        }
    });
}

// Mobile menu functionality
function initializeMobileMenu() {
    const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
    const mobileNav = document.querySelector('.mobile-nav');
    const mobileDropdownToggles = document.querySelectorAll('.mobile-dropdown-toggle');
    
    if (mobileMenuToggle && mobileNav) {
        // Ensure all dropdowns are closed initially
        document.querySelectorAll('.mobile-dropdown').forEach(dropdown => {
            dropdown.classList.remove('active');
        });
        
        // Toggle mobile menu
        mobileMenuToggle.addEventListener('click', function() {
            mobileMenuToggle.classList.toggle('active');
            mobileNav.classList.toggle('active');
            
            // Prevent body scrolling when menu is open
            if (mobileNav.classList.contains('active')) {
                document.body.style.overflow = 'hidden';
                document.body.style.position = 'fixed';
                document.body.style.width = '100%';
            } else {
                document.body.style.overflow = '';
                document.body.style.position = '';
                document.body.style.width = '';
                
                // Close all dropdowns when menu closes
                document.querySelectorAll('.mobile-dropdown').forEach(dropdown => {
                    dropdown.classList.remove('active');
                });
            }
        });
        
        // Close menu when clicking on overlay
        mobileNav.addEventListener('click', function(e) {
            if (e.target === mobileNav) {
                mobileMenuToggle.classList.remove('active');
                mobileNav.classList.remove('active');
                document.body.style.overflow = '';
                document.body.style.position = '';
                document.body.style.width = '';
                
                // Close all dropdowns when menu closes
                document.querySelectorAll('.mobile-dropdown').forEach(dropdown => {
                    dropdown.classList.remove('active');
                });
            }
        });
        
        // Handle mobile dropdown toggles
        mobileDropdownToggles.forEach(toggle => {
            toggle.addEventListener('click', function(e) {
                e.preventDefault();
                const parentDropdown = toggle.closest('.mobile-dropdown');
                const isCurrentlyActive = parentDropdown.classList.contains('active');
                
                // Close all other dropdowns
                document.querySelectorAll('.mobile-dropdown').forEach(dropdown => {
                    dropdown.classList.remove('active');
                });
                
                // Toggle current dropdown
                if (!isCurrentlyActive) {
                    parentDropdown.classList.add('active');
                }
            });
        });
        
        // Close menu when clicking on navigation links
        const mobileNavLinks = document.querySelectorAll('.mobile-nav a:not(.mobile-dropdown-toggle)');
        mobileNavLinks.forEach(link => {
            link.addEventListener('click', function() {
                mobileMenuToggle.classList.remove('active');
                mobileNav.classList.remove('active');
                document.body.style.overflow = '';
            });
        });
    }
}

document.addEventListener('DOMContentLoaded', function() {
    // Load header component
    loadHeaderComponent().then(() => {
        // Initialize mobile menu after header is loaded
        initializeMobileMenu();
    });
    
    // Hero Carousel Functionality
    const heroCarousel = document.querySelector('.carousel-slides');
    const heroPrevButton = document.querySelector('.hero-prev');
    const heroNextButton = document.querySelector('.hero-next');
    const heroDots = document.querySelectorAll('.hero-dot');
    
    if (heroCarousel && heroPrevButton && heroNextButton) {
        let currentHeroSlide = 0;
        const heroSlides = document.querySelectorAll('.hero-slide');
        const heroSlideCount = heroSlides.length;
        let isAnimating = false;
        
        // Regular slide transition - update positions with animation
        function updateHeroCarousel() {
            heroCarousel.style.transition = 'transform 0.5s ease-in-out';
            heroCarousel.style.transform = `translateX(-${currentHeroSlide * 100}%)`;
            
            // Update dots
            heroDots.forEach((dot, index) => {
                dot.classList.toggle('active', index === currentHeroSlide);
            });
        }
        
        // Special transitions for loop cases
        function specialLoopTransition(fromIndex, toIndex) {
            isAnimating = true;
            
            // Setup: Position slides for the special transition
            heroCarousel.style.transition = 'none';
            
            // If going from last to first (next button)
            if (fromIndex === heroSlideCount - 1 && toIndex === 0) {
                // First, position the carousel at the last slide without animation
                heroCarousel.style.transform = `translateX(-${(heroSlideCount - 1) * 100}%)`;
                
                // Clone the first slide and append it to the carousel
                const firstSlideClone = heroSlides[0].cloneNode(true);
                heroCarousel.appendChild(firstSlideClone);
                
                // Force reflow to ensure the browser recognizes the new element
                void heroCarousel.offsetWidth;
                
                // Start the transition animation
                setTimeout(() => {
                    heroCarousel.style.transition = 'transform 0.5s ease-in-out';
                    heroCarousel.style.transform = `translateX(-${heroSlideCount * 100}%)`;
                    
                    // After animation completes, reset to the first slide
                    setTimeout(() => {
                        heroCarousel.style.transition = 'none';
                        heroCarousel.style.transform = 'translateX(0)';
                        heroCarousel.removeChild(firstSlideClone);
                        currentHeroSlide = 0;
                        
                        // Update dots
                        heroDots.forEach((dot, index) => {
                            dot.classList.toggle('active', index === currentHeroSlide);
                        });
                        
                        isAnimating = false;
                    }, 500);
                }, 20);
            } 
            // If going from first to last (prev button)
            else if (fromIndex === 0 && toIndex === heroSlideCount - 1) {
                // Clone the last slide and prepend it to the carousel
                const lastSlideClone = heroSlides[heroSlideCount - 1].cloneNode(true);
                heroCarousel.insertBefore(lastSlideClone, heroSlides[0]);
                
                // Shift the container left to account for the new prepended slide
                heroCarousel.style.transform = 'translateX(-100%)';
                
                // Force reflow to ensure the browser recognizes the new element
                void heroCarousel.offsetWidth;
                
                // Start the transition animation to move right (showing the clone)
                setTimeout(() => {
                    heroCarousel.style.transition = 'transform 0.5s ease-in-out';
                    heroCarousel.style.transform = 'translateX(0)';
                    
                    // After animation completes, jump to the actual last slide
                    setTimeout(() => {
                        heroCarousel.style.transition = 'none';
                        heroCarousel.style.transform = `translateX(-${(heroSlideCount - 1) * 100}%)`;
                        heroCarousel.removeChild(lastSlideClone);
                        currentHeroSlide = heroSlideCount - 1;
                        
                        // Update dots
                        heroDots.forEach((dot, index) => {
                            dot.classList.toggle('active', index === currentHeroSlide);
                        });
                        
                        isAnimating = false;
                    }, 500);
                }, 20);
            }
        }
        
        // Button click handlers with circular navigation
        heroPrevButton.addEventListener('click', () => {
            if (isAnimating) return;
            
            if (currentHeroSlide > 0) {
                currentHeroSlide--;
                updateHeroCarousel();
            } else {
                // Loop to the last slide when on the first slide
                specialLoopTransition(0, heroSlideCount - 1);
            }
        });
        
        heroNextButton.addEventListener('click', () => {
            if (isAnimating) return;
            
            if (currentHeroSlide < heroSlideCount - 1) {
                currentHeroSlide++;
                updateHeroCarousel();
            } else {
                // Loop to the first slide when on the last slide
                specialLoopTransition(heroSlideCount - 1, 0);
            }
        });
        
        // Dot click handlers
        heroDots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
                if (isAnimating) return;
                currentHeroSlide = index;
                updateHeroCarousel();
            });
        });
        
        // Initialize hero carousel
        updateHeroCarousel();
        
        // Auto-advance hero carousel every 7 seconds with circular navigation
        let autoplayInterval = setInterval(() => {
            if (isAnimating) return;
            
            if (currentHeroSlide < heroSlideCount - 1) {
                currentHeroSlide++;
                updateHeroCarousel();
            } else {
                // Loop to the first slide when on the last slide
                specialLoopTransition(heroSlideCount - 1, 0);
            }
        }, 7000);
        
        // Pause autoplay when hovering over the carousel
        heroCarousel.addEventListener('mouseenter', () => {
            clearInterval(autoplayInterval);
        });
        
        // Resume autoplay when mouse leaves the carousel
        heroCarousel.addEventListener('mouseleave', () => {
            autoplayInterval = setInterval(() => {
                if (isAnimating) return;
                
                if (currentHeroSlide < heroSlideCount - 1) {
                    currentHeroSlide++;
                    updateHeroCarousel();
                } else {
                    // Loop to the first slide when on the last slide
                    specialLoopTransition(heroSlideCount - 1, 0);
                }
            }, 7000);
        });
    }
    
    // Tab functionality for research page
    const tabButtons = document.querySelectorAll('.tab-button');
    const tabPanes = document.querySelectorAll('.tab-pane');
    
    // Check if URL has a hash to activate a specific tab
    const hash = window.location.hash;
    if (hash && hash.startsWith('#tab') && document.querySelector(hash)) {
        tabButtons.forEach(btn => btn.classList.remove('active'));
        tabPanes.forEach(pane => pane.classList.remove('active'));
        
        document.querySelector(`[data-tab="${hash.substring(1)}"]`).classList.add('active');
        document.querySelector(hash).classList.add('active');
    }
    
    tabButtons.forEach(button => {
        button.addEventListener('click', function() {
            // Remove active class from all buttons and panes
            tabButtons.forEach(btn => btn.classList.remove('active'));
            tabPanes.forEach(pane => pane.classList.remove('active'));
            
            // Add active class to clicked button and corresponding pane
            const tabId = this.getAttribute('data-tab');
            this.classList.add('active');
            document.getElementById(tabId).classList.add('active');
            
            // Update URL hash without page jump
            history.replaceState(null, null, `#${tabId}`);
        });
    });
    
    // Biography toggle functionality
    const bioToggles = document.querySelectorAll('.bio-toggle');
    
    bioToggles.forEach(toggle => {
        toggle.addEventListener('click', function() {
            const biography = this.nextElementSibling;
            const icon = this.querySelector('i');
            
            if (biography.style.display === 'block') {
                biography.style.display = 'none';
                this.textContent = 'Show Biography ';
                this.appendChild(icon);
                icon.style.transform = 'rotate(0deg)';
            } else {
                biography.style.display = 'block';
                this.textContent = 'Hide Biography ';
                this.appendChild(icon);
                icon.style.transform = 'rotate(180deg)';
            }
        });
    });
    
    // Smooth scrolling for anchor links on the home page
    document.querySelectorAll('.read-more[href^="research.html#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            const tabId = this.getAttribute('href').split('#')[1];
            localStorage.setItem('activeTab', tabId);
        });
    });
    
    // Check for active tab in localStorage when on research page
    if (currentPage === 'research.html' && localStorage.getItem('activeTab')) {
        const storedTabId = localStorage.getItem('activeTab');
        const tabToActivate = document.querySelector(`[data-tab="${storedTabId}"]`);
        
        if (tabToActivate) {
            tabButtons.forEach(btn => btn.classList.remove('active'));
            tabPanes.forEach(pane => pane.classList.remove('active'));
            
            tabToActivate.classList.add('active');
            document.getElementById(storedTabId).classList.add('active');
            
            // Clean up storage after use
            localStorage.removeItem('activeTab');
        }
    }
    
    // News carousel functionality
    const carousel = document.querySelector('.carousel-slide');
    const prevButton = document.querySelector('.carousel-button.prev');
    const nextButton = document.querySelector('.carousel-button.next');
    const dots = document.querySelectorAll('.dot');
    
    if (carousel && nextButton && prevButton) {
        let currentSlide = 0;
        const slides = document.querySelectorAll('.news-item');
        const slideCount = slides.length;
        
        // Hide prev button initially if only one slide
        if (slideCount <= 1) {
            prevButton.style.display = 'none';
            nextButton.style.display = 'none';
        } else {
            // Update carousel display
            function updateCarousel() {
                carousel.style.transform = `translateX(-${currentSlide * 100}%)`;
                
                // Update dots
                dots.forEach((dot, index) => {
                    dot.classList.toggle('active', index === currentSlide);
                });
                
                // Enable/disable buttons
                prevButton.disabled = currentSlide === 0;
                nextButton.disabled = currentSlide === slideCount - 1;
                
                // Update button visibility
                prevButton.style.opacity = currentSlide === 0 ? '0.5' : '1';
                nextButton.style.opacity = currentSlide === slideCount - 1 ? '0.5' : '1';
            }
            
            // Button click handlers
            prevButton.addEventListener('click', () => {
                if (currentSlide > 0) {
                    currentSlide--;
                    updateCarousel();
                }
            });
            
            nextButton.addEventListener('click', () => {
                if (currentSlide < slideCount - 1) {
                    currentSlide++;
                    updateCarousel();
                }
            });
            
            // Dot click handlers
            dots.forEach((dot, index) => {
                dot.addEventListener('click', () => {
                    currentSlide = index;
                    updateCarousel();
                });
            });
            
            // Initialize carousel
            updateCarousel();
            
            // Auto-advance carousel every 5 seconds if more than one slide
            if (slideCount > 1) {
                setInterval(() => {
                    if (currentSlide < slideCount - 1) {
                        currentSlide++;
                    } else {
                        currentSlide = 0;
                    }
                    updateCarousel();
                }, 5000);
            }
        }
    }
}); 